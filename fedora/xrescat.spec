# Generated by porting/scripts/gen-fedora-packaging.py from xrescat/debian/. Do not edit by hand.
Name:           xrescat
Version:        1.2.1
Release:        4%{?dist}
Summary:        cat Xresources
License:        MIT
URL:            https://github.com/regolith-linux/xrescat
Source0:        %{name}-%{version}.tar.gz

BuildRequires:  make
BuildRequires:  gcc
BuildRequires:  pkgconfig(x11)

Provides:       regolith-resource-loader

%description
Simple utility which prints the value of an X resource.

%prep
%autosetup -n %{name}-%{version}

%build
%set_build_flags
%make_build -f fedora/Makefile build

%install
%make_install -f fedora/Makefile PREFIX=%{_prefix} LIBDIR=%{_libdir} SYSCONFDIR=%{_sysconfdir}
# single-binary compiled package: own everything the build installed
(cd %{buildroot} && find . \( -type f -o -type l \) | sed 's|^\.||' \
   | sed -E 's|^(/usr/lib/python3[^/]*/site-packages/[^/]+)/.*|\1|; s|^(/usr/share/man/.*)$|\1*|' \
   | sort -u | sed -E 's|^(/etc/.*)$|%config(noreplace) \1|') > xrescat.files

%files -f xrescat.files

